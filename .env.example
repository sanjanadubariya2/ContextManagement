# Copy to .env and adjust. Every value has a working default for local dev.
MPC_DATABASE_URL=postgresql+psycopg://mpc:mpc@localhost:5433/mpc
MPC_REDIS_URL=redis://localhost:6380/0

# LLM provider: "anthropic" or "fake" (deterministic, offline; used by tests).
# "auto" picks anthropic when credentials are present, otherwise fake.
MPC_LLM_PROVIDER=auto
MPC_LLM_MODEL=claude-opus-5-5
# Smaller model for Researcher and Memorizer (Increment 4).
MPC_LLM_SMALL_MODEL=claude-haiku-4-5
MPC_LLM_EFFORT=medium

# Embeddings: "hash" (deterministic, offline) or "voyage" (needs VOYAGE_API_KEY
# and `uv sync --extra voyage`). The vector column is 1024-d either way.
MPC_EMBED_PROVIDER=hash

# ANTHROPIC_API_KEY=...
# VOYAGE_API_KEY=...
