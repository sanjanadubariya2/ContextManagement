# Copy to .env and adjust. Every value has a working default for local dev.
MPC_DATABASE_URL=postgresql+psycopg://mpc:mpc@localhost:5433/mpc
MPC_REDIS_URL=redis://localhost:6380/0

# LLM provider: gemini | anthropic | auto | fake.
# auto (the default) uses Gemini if GEMINI_API_KEY is set, else Anthropic, else stops
# with an error. fake is a deterministic offline stand-in used only by the tests.
MPC_LLM_PROVIDER=gemini
# Gemini: gemini-3.8-flash is stable; gemini-3.1-pro-preview is stronger but preview.
MPC_GEMINI_MODEL=gemini-3.8-flash
MPC_GEMINI_SMALL_MODEL=gemini-3.8-flash
# Anthropic (used when MPC_LLM_PROVIDER=anthropic).
MPC_LLM_MODEL=claude-opus-5-5
MPC_LLM_SMALL_MODEL=claude-haiku-4-5
MPC_LLM_EFFORT=medium

# Embeddings: "hash" (deterministic, offline), "gemini" (gemini-embedding-001, uses
# GEMINI_API_KEY) or "voyage". The vector column is 1024-d either way; after changing
# it, rebuild the workspace with `uv run mpc init --reset -y`.
MPC_EMBED_PROVIDER=hash

# GEMINI_API_KEY=...        (Google AI Studio key)
# ANTHROPIC_API_KEY=...
# VOYAGE_API_KEY=...
